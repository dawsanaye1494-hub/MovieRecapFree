<script>
const $=id=>document.getElementById(id);let jid=null,timer=null,objUrl=null,voices=[],voice="nilar",gender="f",translator="gemini",ratio="original",font="noto";
const subBox={x:.08,y:.76,w:.84,h:.18},blur={enabled:false,items:[]};let selBlur=0;
const newBlur=()=>({x:.1,y:.78,w:.8,h:.14,start:null,end:null,always:true});blur.items.push(newBlur());
const selB=()=>blur.items[selBlur]||blur.items[0];
const FONTS={noto:["MR Noto","Noto Sans"],padauk:["MR Padauk","Padauk"],padaukb:["MR PadaukB","Padauk Bold"],serif:["MR Serif","Noto Serif"]};
const STEPS={queued:"Queued",extract:"Extracting audio",transcribe:"Transcribing",translate:"Translating to Burmese",awaiting_edit:"Ready to edit",render:"Generating video",done:"Completed",error:"An error occurred"};
const esc=s=>(s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const fmt=s=>{s=Math.floor(s);return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")};
function setStep(n){document.querySelectorAll("#steps span").forEach(e=>{const s=+e.dataset.s;e.className=s<n?"ok":s===n?"on":""})}
function segBtns(id,attr,cb){$(id).addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;
 $(id).querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));cb(b.dataset[attr])})}
$("voiceHome").appendChild($("voicePanel"));

/* voices */
async function loadVoices(){voices=await(await fetch("/voices")).json();renderVoices()}
const isMine=v=>/^(my|sv):/.test(v||"");let mvPrefix=(()=>{try{return ["my:","sv:"].includes(localStorage.mvMode)?localStorage.mvMode:"my:"}catch(e){return "my:"}})();
/* v103: the voice list follows the narration language chosen in the language step */
const narrLang=()=>(window.OL&&OL.voice)||"my";
const langVoices=()=>{const L=narrLang();return voices.filter(v=>L==="my"?(v.lang==="my"||v.lang==="multi"):L==="en"?v.lang==="multi":v.lang===L)};
function renderVoices(){const myId=mvPrefix+(gender==="m"?"thiha":"nilar"),L=narrLang(),ln=(window.OL&&OL.name(L))||"Burmese";
 const list=langVoices().filter(v=>v.gender===gender);
 if(!isMine(voice)&&list.length&&!list.find(v=>v.id===voice))voice=list[0].id;
 $("voiceList").innerHTML=list.map(v=>
 `<div class="vc ${v.id===voice?"on":""}" data-id="${v.id}"><b>${esc(v.name)}</b><small>${v.lang==="multi"?'<span class="badge m">Multilingual</span>':`<span class="badge n">${esc(ln)} native</span>`}</small></div>`).join("")
 +`<div class="vc ${voice===myId?"on":""}" data-id="${myId}"><b>My Voice</b><small>With your voice sample</small></div>`;
 const base=(list.find(v=>v.gender===gender)||{}).name||(gender==="m"?"Thiha":"Nilar");
 const my=isMine(voice);$("myVoice").classList.toggle("hide",!my);$("mvBase").textContent=base;if(my)showMode()}
$("voiceList").onclick=e=>{const c=e.target.closest(".vc");if(!c)return;voice=c.dataset.id;renderVoices();
 const why=voiceNotReady();if(why){$("mvMsg").textContent=why;return}speak($("testTxt").value,$("testBtn"),$("testMsg"))};
segBtns("gSel","g",g=>{gender=g;if(isMine(voice))voice=mvPrefix+(g==="m"?"thiha":"nilar");
 else{const first=langVoices().find(v=>v.gender===g);if(first&&!langVoices().find(v=>v.id===voice&&v.gender===g))voice=first.id}renderVoices()});
$("rate").oninput=e=>$("rateV").textContent=(e.target.value>0?"+":"")+e.target.value+"%";
$("pitch").oninput=e=>$("pitchV").textContent=(e.target.value>0?"+":"")+e.target.value+"Hz";
/* v103: spkLang = the narration language code, or "orig" (keep the video's own voice) */
let spkLang="my";const MY_TEST="မင်္ဂလာပါ။ ဒီနေ့ ဇာတ်ကားလေး တစ်ကားကို အကျဉ်းချုပ်ပြီး ပြောပြပေးသွားပါမယ်။",EN_TEST="Hello. Today I will tell you the story of this movie in a short recap.";
const sampleOf=l=>(window.OL&&OL.sample(l))||(l==="en"?EN_TEST:MY_TEST);
segBtns("spkSel","s",v=>{spkLang=v==="orig"?"orig":narrLang();$("origNote").classList.toggle("hide",v!=="orig");
 if(v==="orig")$("subs").checked=true});
window.applyOutLangUi=()=>{const L=narrLang(),S=(window.OL&&OL.sub)||L;if(spkLang!=="orig")spkLang=L;
 $("spkLangName").textContent=OL.name(L);$("subLangName").textContent=S==="none"?"none":OL.name(S);
 $("subs").checked=S!=="none";$("subBox").classList.toggle("hide",S==="none");
 const t=$("testTxt");if(!t.dataset.edited)t.value=sampleOf(L);renderVoices()};
$("testTxt").addEventListener("input",()=>$("testTxt").dataset.edited="1");
const voiceOpts=()=>({voice,speak:spkLang,rate:+$("rate").value,pitch:+$("pitch").value});
const player=new Audio();
async function speak(text,btn,msgEl){if(!text.trim())return alert("No text entered");
 {const why=voiceNotReady();if(why)return alert(why)}
 const old=btn.textContent;btn.disabled=true;btn.textContent="⏳ Generating audio...";
 try{const r=await(await fetch("/tts_test",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({text,...voiceOpts()})})).json();
  if(r.error)throw new Error(r.error);const url=r.url+"?t="+Date.now();
  if(msgEl){$("testAud").src=url;$("testAud").classList.remove("hide");$("testAud").play();
   const ENG={myvoice:"✓ My Voice (voice colour)",stylevc:"✓ My Voice (style copy)",edge:"✓ Microsoft Neural Voice"};
   msgEl.className=ENG[r.engine]?"ok":"warn";msgEl.textContent=ENG[r.engine]||"⚠ No internet — offline voice"}
  else{player.src=url;player.play()}}catch(e){alert(e.message)}finally{btn.disabled=false;btn.textContent=old}}
$("testBtn").onclick=()=>speak($("testTxt").value,$("testBtn"),$("testMsg"));

/* my own voice */
let myRef=null,rec=null,recT=null;
function showRef(r){myRef=r;$("mvHave").classList.toggle("hide",!r);
 if(r){$("mvAud").src="/myvoice/ref.wav?t="+Date.now();
  if(r.old){$("mvMsg").className="warn";$("mvMsg").textContent=`⚠ ${r.seconds}s sample from an older version (low quality, pauses removed) — please record again for Instant style copy`}
  else{$("mvMsg").className="ok";$("mvMsg").textContent=`✓ ${r.seconds}s recorded`+(r.seconds<20?" — for Instant style copy record 30 s or more":"")}}
 else{$("mvMsg").className="muted";$("mvMsg").textContent="No sample yet"}}
async function sendRef(blob,name){$("mvMsg").className="muted";$("mvMsg").textContent="⏳ Saving...";const fd=new FormData();fd.append("audio",blob,name);
 const r=await(await fetch("/myvoice",{method:"POST",body:fd})).json();if(r.error){$("mvMsg").className="err";$("mvMsg").textContent="⚠ "+r.error;return}showRef(r.ref)}
fetch("/myvoice").then(r=>r.json()).then(r=>showRef(r.ref)).catch(()=>{});
$("mvFile").onchange=e=>{const f=e.target.files[0];if(f)sendRef(f,f.name);e.target.value=""};
$("mvDel").onclick=async()=>{await fetch("/myvoice",{method:"DELETE"});showRef(null)};
$("recBtn").onclick=async()=>{if(rec&&rec.state==="recording"){rec.stop();return}
 try{/* raw microphone: the browser's noise suppression / auto-gain smear consonants and pump the volume, which the voice copy then imitates */
  const stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false,channelCount:1,sampleRate:48000}});const chunks=[];
  let opts={audioBitsPerSecond:256000};for(const t of ["audio/webm;codecs=opus","audio/ogg;codecs=opus"])if(window.MediaRecorder&&MediaRecorder.isTypeSupported&&MediaRecorder.isTypeSupported(t)){opts.mimeType=t;break}
  try{rec=new MediaRecorder(stream,opts)}catch(e){rec=new MediaRecorder(stream)}
  rec.ondataavailable=e=>chunks.push(e.data);const t0=Date.now();
  rec.onstop=()=>{clearInterval(recT);stream.getTracks().forEach(t=>t.stop());$("recBtn").textContent="Record";sendRef(new Blob(chunks,{type:rec.mimeType}),"rec.webm")};
  rec.start();$("recBtn").innerHTML='<span class="rec"></span>Stop';
  recT=setInterval(()=>{const s=(Date.now()-t0)/1000;$("mvMsg").className="muted";$("mvMsg").textContent=`Recording ${s.toFixed(0)}s — narrate naturally, the way you do in your recaps${s<30?" (keep going: 30 s – 2 min is best)":""}`;if(s>=180)rec.stop()},250);
 }catch(e){alert("Cannot access mic: "+e.message)}};

/* how closely to copy you: voice colour / instant style copy */
const MODE_NOTE={"my:":"Your voice colour only — the rhythm and intonation stay Microsoft's. Small download (~130 MB), fast.",
 "sv:":"Copies your voice colour AND your way of speaking: your pitch, your melody range, your speed and your pauses. Words stay as clear as Nilar/Thiha (the one closest to your pitch is used). Record 30 s – 2 min of natural narration below in a quiet room, mouth about a hand away from the mic. No training. One-time free download of about 4 GB (about 7 GB with an NVIDIA card). Fast with an NVIDIA card; on a normal processor about 20 s of work per second of speech."};
let svSt=null,svT=null;
function voiceNotReady(){if(!isMine(voice))return "";const p=voice.slice(0,3);
 if(!myRef)return "Please record your voice sample first";
 if(p==="sv:"&&!(svSt&&svSt.installed))return "Install the style engine first (Instant style copy → Install)";return ""}
function showMode(){document.querySelectorAll("#mvMode button").forEach(b=>b.classList.toggle("on",b.dataset.m===mvPrefix));
 $("mvModeNote").textContent=MODE_NOTE[mvPrefix];$("svBox").classList.toggle("hide",mvPrefix!=="sv:");
 $("mvSampleLabel").textContent=mvPrefix==="sv:"?"Your voice sample (30 s – 2 min of natural narration · up to 3 min)":"Your voice sample (min 3s · 10–30s for better accuracy)";
 if(!myRef)showRef(null);   /* clear a "record a sample first" hint left by the previous mode */
 if(mvPrefix==="sv:"&&!svSt)loadSv()}
segBtns("mvMode","m",m=>{mvPrefix=m;try{localStorage.mvMode=m}catch(e){}voice=m+(gender==="m"?"thiha":"nilar");renderVoices()});
/* instant style copy */
async function loadSv(){try{svSt=await(await fetch("/stylevc")).json()}catch(e){return}renderSv();
 clearTimeout(svT);if(svSt.installing)svT=setTimeout(loadSv,2000)}
function renderSv(){const s=svSt||{};$("svInstall").classList.toggle("hide",!!s.installed);$("svInstall").disabled=!!s.installing;
 $("svRemove").classList.toggle("hide",!s.installed);$("svStrRow").classList.toggle("hide",!s.installed);
 document.querySelectorAll("#svStr button").forEach(b=>b.classList.toggle("on",b.dataset.v===(s.strength||"balanced")));
 const m=$("svMsg");if(s.installing){m.className="muted";m.textContent="⏳ "+(s.step||"Installing...")}
 else if(s.error){m.className="err";m.textContent="⚠ Install failed — see the details below, then press Install again (finished parts are kept)"}
 else if(s.installed){m.className="ok";m.textContent="✓ Style engine ready"+(s.info&&s.info.device==="cuda"?" (NVIDIA)":" (CPU — about 20 s of work per second of speech)")+(s.upgraded?"":" · improved v75 voice models (about 2 GB) download automatically on the first Test Listen")}
 else{m.className="muted";m.textContent="Not installed (free, one-time download)"}
 const lg=$("svLog");lg.classList.toggle("hide",!(s.log&&s.log.length)||s.installed);lg.textContent=(s.log||[]).slice(-6).join("\n")}
$("svInstall").onclick=async()=>{if(!await uiConfirm("Download and install the free style engine now?\n\nAbout 4 GB (about 7 GB with an NVIDIA card). This happens once; you can keep using the app while it installs."))return;
 const r=await(await fetch("/stylevc/install",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"})).json();if(r.error)return alert(r.error);svSt=r;renderSv();loadSv()};
$("svRemove").onclick=async()=>{if(!await uiConfirm("Remove the style engine and free its disk space?"))return;const r=await(await fetch("/stylevc",{method:"DELETE"})).json();if(r.error)return alert(r.error);loadSv()};
segBtns("svStr","v",async v=>{await fetch("/stylevc/strength",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({strength:v})});if(svSt)svSt.strength=v});
loadSv();

/* upload */
function pick(f){if(!f)return;Object.assign(crop,{x:0,y:0,w:1,h:1});$("importError").textContent="";if(objUrl)URL.revokeObjectURL(objUrl);objUrl=URL.createObjectURL(f);
 $("upVid").src=objUrl;$("upStage").classList.remove("hide");$("upBtn").disabled=false;$("drop").querySelector("b").textContent=f.name;$("cropRow").classList.remove("hide");$("drop").classList.add("picked");setTimeout(placeCrop,50)}
$("file").onchange=e=>pick(e.target.files[0]);
["dragover","dragenter"].forEach(n=>$("drop").addEventListener(n,e=>{e.preventDefault();$("drop").classList.add("over")}));
["dragleave","drop"].forEach(n=>$("drop").addEventListener(n,e=>{e.preventDefault();$("drop").classList.remove("over")}));
$("drop").addEventListener("drop",e=>{const f=e.dataTransfer.files[0];if(f){$("file").files=e.dataTransfer.files;pick(f)}});

/* crop before upload (logo / unwanted area removal) */
const crop={x:0,y:0,w:1,h:1};
function upRect(){const v=$("upVid"),W=v.clientWidth,H=v.clientHeight,vw=v.videoWidth||16,vh=v.videoHeight||9;
 const sc=Math.min(W/vw,H/vh);return{x:(W-vw*sc)/2,y:(H-vh*sc)/2,w:vw*sc,h:vh*sc}}
function placeCrop(){const b=$("cropBox"),on=$("cropOn").checked;
 $("cropControls").classList.toggle("hide",!on);b.classList.toggle("hide",!on);
 for(const k of ["x","y","w","h"])$("crop_"+k).value=+(crop[k]*100).toFixed(2);
 const v=$("upVid");$("cropSize").textContent=v.videoWidth?`${Math.floor(crop.w*v.videoWidth/2)*2} × ${Math.floor(crop.h*v.videoHeight/2)*2} px`:"";
 if(!on)return;const r=upRect();b.style.left=r.x+crop.x*r.w+"px";b.style.top=r.y+crop.y*r.h+"px";
 b.style.width=crop.w*r.w+"px";b.style.height=crop.h*r.h+"px"}
$("cropOn").onchange=()=>{$("cropHint").classList.toggle("hide",!$("cropOn").checked);placeCrop()};
$("cropReset").onclick=()=>{Object.assign(crop,{x:0,y:0,w:1,h:1});placeCrop()};
for(const k of ["x","y","w","h"])$("crop_"+k).oninput=e=>{
 const n=Number(e.target.value);if(!Number.isFinite(n))return;const value=n/100;
 if(k==="x"||k==="y")crop[k]=Math.max(0,Math.min(value,1-crop[k==="x"?"w":"h"]));
 else crop[k]=Math.max(.05,Math.min(value,1-crop[k==="w"?"x":"y"]));placeCrop()};
$("upVid").addEventListener("loadedmetadata",placeCrop);window.addEventListener("resize",placeCrop);
new ResizeObserver(placeCrop).observe($("upStage"));
$("cropBox").addEventListener("pointerdown",e=>{e.preventDefault();const edge=e.target.dataset.edge||"";
 const el=$("cropBox"),r=upRect();if(!r.w||!r.h)return;el.setPointerCapture(e.pointerId);
 const sx=e.clientX,sy=e.clientY,st={...crop},clamp=(v,lo,hi)=>Math.max(lo,Math.min(v,hi));
 el.onpointermove=ev=>{const dx=(ev.clientX-sx)/r.w,dy=(ev.clientY-sy)/r.h;
  if(!edge){crop.x=clamp(st.x+dx,0,1-st.w);crop.y=clamp(st.y+dy,0,1-st.h)}
  else{if(edge.includes("w")){crop.x=clamp(st.x+dx,0,st.x+st.w-.05);crop.w=st.x+st.w-crop.x}
   if(edge.includes("e"))crop.w=clamp(st.w+dx,.05,1-st.x);
   if(edge.includes("n")){crop.y=clamp(st.y+dy,0,st.y+st.h-.05);crop.h=st.y+st.h-crop.y}
   if(edge.includes("s"))crop.h=clamp(st.h+dy,.05,1-st.y)}placeCrop()};
 const cleanup=()=>{el.onpointermove=null};el.onpointerup=cleanup;el.onpointercancel=cleanup;el.onlostpointercapture=cleanup});
localStorage.removeItem("gemini_key");
/* upload mode: recap or split only */
let upMode="recap";
segBtns("modeSel","v",v=>{upMode=v;$("upSplitOpts").classList.toggle("hide",v!=="split");$("voiceHome").classList.toggle("hide",v==="split");
 $("upBtn").textContent=v==="split"?"✂ Start Split Video":"▶ Start Movie Recap";$("langRow").classList.toggle("hide",v==="split")});
segBtns("upSplitSel","m",m=>$("upSplitMin").value=m);
const splitOpt={up:{ratio:"original",fit:"fit"},sp:{ratio:"original",fit:"fit"}};
const PV_RATIOS={"16:9":[1280,720],"9:16":[720,1280],"1:1":[1080,1080],"4:5":[1080,1350],"4:3":[960,720]};
function drawSplitPv(p){const cv=$(p+"Pv");if(!cv||!cv.offsetParent)return;const v=p==="up"?$("upVid"):$("vid");
 let sx=0,sy=0,sw=v.videoWidth,sh=v.videoHeight;if(!sw||!sh)return;
 if(p==="up"&&$("cropOn").checked){sx=crop.x*sw;sy=crop.y*sh;sw=crop.w*sw;sh=crop.h*sh}
 const o=splitOpt[p],[W,H]=PV_RATIOS[o.ratio]||[Math.round(sw),Math.round(sh)];
 const maxH=220,maxW=cv.parentElement.clientWidth||320,k=Math.min(maxW/W,maxH/H),cw=Math.round(W*k),ch=Math.round(H*k);
 if(cv.width!==cw||cv.height!==ch){cv.width=cw;cv.height=ch}
 const x=cv.getContext("2d");x.fillStyle="#000";x.fillRect(0,0,cw,ch);
 const sc=(o.fit==="fill"&&PV_RATIOS[o.ratio]?Math.max:Math.min)(cw/sw,ch/sh),dw=sw*sc,dh=sh*sc;
 try{x.drawImage(v,sx,sy,sw,sh,(cw-dw)/2,(ch-dh)/2,dw,dh)}catch(e){}
 $(p+"PvInfo").textContent=`· ${W}×${H}${PV_RATIOS[o.ratio]?(o.fit==="fill"?" · Crop":" · Letterbox"):" · Original"}`}
(function pvLoop(){drawSplitPv("up");drawSplitPv("sp");requestAnimationFrame(pvLoop)})();
["up","sp"].forEach(p=>{segBtns(p+"RatioSel","r",r=>{splitOpt[p].ratio=r;$(p+"FitRow").classList.toggle("hide",r==="original")});
 segBtns(p+"FitSel","f",f=>splitOpt[p].fit=f)});
/* split part rows: in the desktop window a plain <a> download does nothing, so
   clicks are intercepted below and routed to the native save dialog */
function partRow(p,i){return `<div class="row" style="margin-bottom:4px"><span>Part ${i+1} · ${fmt(p.seconds)}</span><a class="partdl" data-name="${p.name}" href="/part/${jid}/${p.name}" style="flex:0 0 auto"><button class="ghost">Download</button></a></div>`}
document.addEventListener("click",e=>{const a=e.target.closest("a.partdl");if(!a)return;
 if(window.pywebview&&pywebview.api){e.preventDefault();pywebview.api.save_part(jid,a.dataset.name).then(r=>{if(r)$("log").textContent+="\nSaved: "+r+"\n"})}});
async function splitOnly(btn,label){const minutes=+$("upSplitMin").value||5;$("upSplitList").innerHTML="";
 const sr=await(await fetch("/split/"+jid,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({minutes,...splitOpt.up})})).json();
 if(sr.error)throw new Error(sr.error);$("upSplitMsg").className="muted";
 const t=setInterval(async()=>{const s=await(await fetch("/status/"+jid)).json();const sp=s.split||{};
  $("log").textContent=(s.log||[]).join("\n");$("barI").style.width=(sp.progress||0)+"%";$("pct").textContent=(sp.progress||0)+"%";
  if(!sp.done&&!sp.error)$("upSplitMsg").textContent=`⏳ Splitting... ${sp.progress||0}%`;
