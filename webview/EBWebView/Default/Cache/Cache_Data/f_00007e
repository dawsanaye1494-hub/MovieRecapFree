<script>
/* v103: language step — the narrator's language and the subtitle language are chosen first, then the feature opens */
(function(){const $$=id=>document.getElementById(id),hp=$$("homePick"),lp=$$("langPick");
 const names={recap:"· Recap → Recap",short:"· Long → Short",movie:"· Original → Recap",split:"· Split Video"};
 const TITLES={recap:"Recap → Recap",short:"Long → Short",movie:"Original → Recap",news:"News Studio",horror:"Horror Stories"};
 let LIST=[],pending=null;
 const saved=(()=>{try{return JSON.parse(localStorage.outLangV103||"{}")}catch(e){return {}}})();
 window.OL={voice:saved.voice||"my",sub:saved.sub||saved.voice||"my",list:[],
  name:c=>{const x=LIST.find(l=>l.id===c);return x?x.name.replace(/ \(.*\)$/,""):c==="my"?"Burmese":c},
  sample:c=>{const x=LIST.find(l=>l.id===c);return x&&x.sample},
  cps:c=>({my:10,en:14,zh:4.4,ja:7,ko:6,th:12,lo:10,km:10}[c]||13)};
 const esc3=t=>String(t||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
 function chip(){const v=OL.voice,sb=OL.sub;$$("lpChipV").textContent=OL.name(v);$$("lpChipS").textContent=sb==="none"?"No subtitles":OL.name(sb);
  $$("lpNow").textContent="🗣 "+OL.name(v)+" · 💬 "+(sb==="none"?"no subtitles":OL.name(sb));
  const ft=$$("featTag");if(window.feature&&window.feature!=="split")ft.textContent=(names[window.feature]||"")+" · 🗣 "+OL.name(v)+(sb!==v?" · 💬 "+(sb==="none"?"no subs":OL.name(sb)):"");
  if(window.applyOutLangUi)window.applyOutLangUi()}
 function grids(){$$("lpVoice").innerHTML=LIST.map(l=>`<button data-v="${l.id}" class="${l.id===OL.voice?"on":""}"><b>${esc3(l.native)}</b><small>${esc3(l.name)}</small></button>`).join("");
  $$("lpSubs").innerHTML=`<button data-s="same" class="${OL.sub===OL.voice?"on":""}"><b>Same as narrator</b><small>${esc3(OL.name(OL.voice))}</small></button>`+
   LIST.filter(l=>l.id!==OL.voice).map(l=>`<button data-s="${l.id}" class="${l.id===OL.sub?"on":""}"><b>${esc3(l.native)}</b><small>${esc3(l.name)}</small></button>`).join("")+
   `<button data-s="none" class="none ${OL.sub==="none"?"on":""}"><b>No subtitles</b><small>Only the voice</small></button>`}
 fetch("/outlangs").then(r=>r.json()).then(d=>{LIST=d.langs||[];OL.list=LIST;if(!LIST.find(l=>l.id===OL.voice))OL.voice="my";grids();chip()}).catch(()=>{});
 $$("lpVoice").addEventListener("click",e=>{const b=e.target.closest("[data-v]");if(!b)return;const was=OL.voice;OL.voice=b.dataset.v;
  if(OL.sub===was||OL.sub===OL.voice)OL.sub=OL.voice;grids();chip()});
 $$("lpSubs").addEventListener("click",e=>{const b=e.target.closest("[data-s]");if(!b)return;OL.sub=b.dataset.s==="same"?OL.voice:b.dataset.s;grids();chip()});
 function openLang(f,back){if(f==="split"){applyFeature("split");return}pending=f;$$("lpSub").textContent=(TITLES[f]?TITLES[f]+" — ":"")+"first choose the narrator's language and the subtitles, then continue.";
  grids();chip();lp.classList.remove("hide");lp.dataset.back=back||"home"}
 window.pickLang=openLang;
 $$("lpBack").onclick=()=>{lp.classList.add("hide");if(lp.dataset.back==="home"&&!jid){hp.classList.remove("hide");window.feature=null;$$("featTag").textContent=""}};
 $$("lpGo").onclick=()=>{try{localStorage.outLangV103=JSON.stringify({voice:OL.voice,sub:OL.sub})}catch(e){}
  lp.classList.add("hide");const f=pending;pending=null;chip();
  if(f==="news"){if(window.newsSetLang)window.newsSetLang(OL.voice,OL.sub);$$("newsBtn").click();return}
  if(f==="horror"){if(window.horrorSetLang)window.horrorSetLang(OL.voice,OL.sub);$$("horrorBtn").click();return}
  if(f)applyFeature(f)};
 $$("lpChange").onclick=()=>{if(window.feature==="split")return;if(jid)return alert("The languages are fixed once a video is uploaded. Start a new video to change them.");openLang(window.feature,"upload")};
 window.feature=null;
 hp.addEventListener("click",e=>{const b=e.target.closest(".fcard");if(!b)return;const f=b.dataset.f;
  if(f==="split"){applyFeature("split");return}
  hp.classList.add("hide");openLang(f,"home")});
 /* split is its own feature now: upload -> parts (no voice, no language) */
 function applyFeature(f){
  window.feature=f;hp.classList.add("hide");lp.classList.add("hide");$$("featTag").textContent=names[f]||"";
  const want=f==="split"?"split":"recap",mb=document.querySelector(`#modeSel button[data-v="${want}"]`);if(mb&&!mb.classList.contains("on"))mb.click();
  $$("modeRow").classList.add("hide");$$("lpChip").classList.toggle("hide",f==="split");
  const ul=$$("upLenRow");if(ul)ul.classList.toggle("hide",f!=="movie");
  const gb=$$("genBtn");if(gb)gb.textContent=f==="movie"?"🎞 Make Movie Recap":f==="short"?"🎬 Make Short Video":"Generate Video";
  const up=$$("upBtn");if(up)up.textContent=f==="split"?"✂ Start Split Video":f==="short"?"▶ Start Long → Short":f==="movie"?"▶ Start Original → Recap":"▶ Start Movie Recap";
  if(f!=="split")chip()}
 window.switchFeature=f=>{if(f==="split"){applyFeature("split");return}hp.classList.add("hide");openLang(f,"home")};
 window.goHome=()=>{lp.classList.add("hide");hp.classList.remove("hide");window.feature=null;$$("featTag").textContent=""};
 // reopening a saved job skips the pickers
 const obs=new MutationObserver(()=>{if(!$$("editView").classList.contains("hide")){hp.classList.add("hide");lp.classList.add("hide")}});
 obs.observe($$("editView"),{attributes:true,attributeFilter:["class"]});
})();
</script>
