 <div class="row" style="flex-wrap:wrap;gap:6px;margin:0 0 8px;align-items:center"><span class="muted" style="font-size:12px;flex:0 0 auto">Rednote:</span><span id="rnState" class="muted" style="font-size:12px;flex:0 1 auto"></span><button class="ghost" id="rnSignIn" style="flex:0 0 auto">Sign in to Rednote</button><button class="ghost hide" id="rnSignOut" style="flex:0 0 auto">Sign out</button></div>
 <div id="refInfo" class="hide"><b id="refTitle"></b><div class="row" style="margin:8px 0"><label class="l">Resolution<select id="refQuality"></select></label><button class="btn" id="refDownload" style="flex:0 0 auto">↓ Download video</button></div></div>
