<script>
/* v83: a preview never keeps playing where you cannot see it (movie recap, short video, news, references).
   It pauses when you go to another step / tab / window (News, References, Download, Storage…), when the
   player is hidden, and when you switch to another program or minimise the app. */
(()=>{
 const media=()=>[...document.querySelectorAll("video,audio")];
 const zi=m=>{const z=parseInt(getComputedStyle(m).zIndex,10);return isNaN(z)?0:z};
 function topModal(){let top=null;document.querySelectorAll(".modal").forEach(m=>{if(m.classList.contains("hide")||getComputedStyle(m).display==="none")return;if(!top||zi(m)>=zi(top))top=m});return top}
 function shown(v){if(!v.isConnected||v.closest(".hide"))return false;if(document.fullscreenElement&&(document.fullscreenElement===v||document.fullscreenElement.contains(v)))return true;
  if(v.offsetParent===null&&getComputedStyle(v).position!=="fixed")return false;const t=topModal();return !t||t.contains(v)}
 function check(){for(const v of media())if(!v.paused&&!shown(v))v.pause()}
 function pauseAll(){for(const v of media())if(!v.paused)v.pause()}
 window.pauseAllMedia=pauseAll;
 document.addEventListener("visibilitychange",()=>{if(document.hidden)pauseAll()});
 window.addEventListener("pagehide",pauseAll);
 window.addEventListener("blur",()=>setTimeout(()=>{const a=document.activeElement;if(a&&a.tagName==="IFRAME")return;if(!document.hasFocus())pauseAll()},150));
 // another inspector tab (Subtitles / Blur / Voice / Video / Texts / Short video) is another place too
 document.addEventListener("click",e=>{const b=e.target.closest("#tabs button");if(b&&!b.classList.contains("on"))pauseAll();setTimeout(check,0)},true);
 new MutationObserver(()=>check()).observe(document.body,{subtree:true,attributes:true,attributeFilter:["class","style","hidden"],childList:true});
 document.addEventListener("play",e=>{setTimeout(()=>{const v=e.target;if(v&&!v.paused&&!shown(v))v.pause()},0)},true);
})();
