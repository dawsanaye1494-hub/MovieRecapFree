  x.filter=`blur(${Math.max(4,dh*.02)}px)`;x.drawImage(v,dx,dy,dw,dh);x.restore()});
 x.restore();
 $("rpInfo").textContent=`· ${W}×${H}${$("mirror").checked?" · mirror":""}`;
 if(!$("subs").checked)return;
 const bx=dx+subBox.x*dw,by=dy+subBox.y*dh,bw=subBox.w*dw,bh=subBox.h*dh;
 if(!previewLayout)return;
 const fs=previewLayout.size*S,lh=previewLayout.line_height*S;
