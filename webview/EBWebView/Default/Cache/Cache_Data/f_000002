(()=>{
 const el=id=>document.getElementById(id);let inspection=null,checking=false,sites=[],polling=false,searching=false,current=null,loaded=false;
 async function del(path){const r=await fetch(path,{method:'DELETE'});const j=await r.json();if(!r.ok||j.error)throw new Error(j.error||'Request failed');return j}
 async function api(path,body){const r=await fetch(path,body===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json();if(!r.ok||j.error){const e=new Error(j.error||'Request failed');e.data=j;throw e}return j}
 function msg(s,bad=false){el('refMessage').className=bad?'err':'muted';el('refMessage').textContent=s}
 function smsg(s,bad=false){el('rsMsg').className=bad?'err':'muted';el('rsMsg').textContent=s}
 const fmtDur=d=>{if(!d)return'';d=Math.round(d);const h=Math.floor(d/3600),m=Math.floor(d%3600/60),s=String(d%60).padStart(2,'0');return h?`${h}:${String(m).padStart(2,'0')}:${s}`:`${m}:${s}`};
 const fmtViews=v=>v==null?'':v>=1e6?(v/1e6).toFixed(1)+'M views':v>=1e3?Math.round(v/1e3)+'K views':v+' views';
 /* ---------- Find references (in-app search + player) ---------- */
 const CHIPS=['movie recap','movie explained','电影解说','สรุปหนัง','영화 리뷰 요약','anime recap','horror movie recap','kdrama recap'];
 function stopPlayer(){current=null;el('rsFrame').replaceChildren();el('rsPlayer').classList.add('hide');document.querySelectorAll('.rcard.sel').forEach(c=>c.classList.remove('sel'))}
 function play(it,card){current=it;document.querySelectorAll('.rcard.sel').forEach(c=>c.classList.remove('sel'));card.classList.add('sel');el('rsTitle').textContent=it.title;el('rsMeta').className='muted';el('rsMeta').textContent=[it.channel,fmtDur(it.duration),fmtViews(it.views)].filter(Boolean).join(' · ');el('rsFrame').replaceChildren();
  if(it.rednote){rnPlay(it);el('rsPlayer').classList.remove('hide');el('rsPlayer').scrollIntoView({block:'nearest'});return}
  if(it.embed){const f=document.createElement('iframe');f.src=it.embed;f.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';f.allowFullscreen=true;f.referrerPolicy='strict-origin-when-cross-origin';el('rsFrame').append(f)}
  else if(it.thumb){const i=document.createElement('img');i.src=it.thumb;i.style.cssText='width:100%;height:100%;object-fit:contain';el('rsFrame').append(i)}
  el('rsPlayer').classList.remove('hide');el('rsPlayer').scrollIntoView({block:'nearest'})}
 /* Rednote: no embed player. The app streams the post's H.264 file here; if that does not play
