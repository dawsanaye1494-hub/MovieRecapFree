   q('.up').onclick=()=>{[beats[i-1],beats[i]]=[beats[i],beats[i-1]];drawBeats();dirty()};q('.dn').onclick=()=>{[beats[i+1],beats[i]]=[beats[i],beats[i+1]];drawBeats();dirty()};
