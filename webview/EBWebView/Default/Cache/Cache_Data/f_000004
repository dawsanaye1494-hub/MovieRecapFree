 const TAGS=['','BREAKING','UPDATE','TRANSFER','RESULT','WEIRD','BOX OFFICE','TRAILER','EXCLUSIVE','LIVE'];
 function drawBeats(){if(!P)return;const box=el('nwBeats');box.replaceChildren();const beats=P.script.beats;
  if(!beats.length){const p=document.createElement('p');p.className='muted';p.textContent='No beats yet. Go to Story and write the script, or press "+ Add beat".';box.append(p)}
  beats.forEach((b,i)=>{const d=document.createElement('div');d.className='nwbeat';d.dataset.i=i;const m=P.media.find(x=>x.id===b.media);
   const opts=['<option value="">— no picture —</option>'].concat(P.media.map((x,k)=>`<option value="${x.id}" ${x.id===b.media?'selected':''}>${k+1}. ${x.kind==='video'?'🎞':'🖼'} ${esc(x.name.slice(0,40))}</option>`)).join('');
   const sel=(arr,v)=>arr.map(([a,t])=>`<option value="${a}" ${a===v?'selected':''}>${t}</option>`).join('');
   d.innerHTML=`<div class="hdr"><b>Beat ${i+1} <span class="muted es"></span></b><button class="ghost pv" title="Preview this beat">👁</button><button class="ghost up" ${i?'':'disabled'}>▲</button><button class="ghost dn" ${i<beats.length-1?'':'disabled'}>▼</button><button class="ghost rm" title="Delete beat">✕</button></div>
    <textarea class="say" rows="3" style="width:100%" placeholder="What the narrator says">${esc(b.say)}</textarea>
    <div class="g"><div><label>On-screen headline</label><input type="text" class="title" value="${esc(b.title)}"></div><div><label>Small line under it</label><input type="text" class="sub" value="${esc(b.sub)}"></div><div><label>Badge</label><input type="text" class="nb-tag" list="nwTags" value="${esc(b.tag)}"></div></div>
    <div class="g2"><img class="mt" ${m?`src="${mThumb(m,b)}"`:''} alt=""><div><label>Picture / clip</label><select class="media">${opts}</select></div>
     <div class="vid ${m&&m.kind==='video'?'':'hide'}"><label>Clip from – to (s)</label><div class="row" style="gap:4px"><input type="number" class="in" min="0" step="0.5" value="${b.in||0}" style="width:72px" title="The clip starts here"><input type="number" class="out" min="0" step="0.5" value="${b.out||0}" style="width:72px" title="The clip stops here (0 = it runs on while the beat is spoken)"></div><div class="momt">${momTxt(b)}</div><label class="check" style="margin:3px 0 0"><input type="checkbox" class="snd" ${b.sound?'checked':''}> clip sound</label></div>
     <div class="img ${m&&m.kind==='video'?'hide':''}"><label>Movement</label><select class="move">${sel([['auto','Auto'],['zoomin','Zoom in'],['zoomout','Zoom out'],['panleft','Pan left'],['panright','Pan right'],['still','Still']],b.move)}</select></div>
     <div><label>Fit</label><select class="fit">${sel([['auto','Auto'],['fill','Fill (crop)'],['fit','Whole picture']],b.fit)}</select></div>
     <div><label>Transition in</label><select class="tr">${sel([['','Default'],['flash','Flash'],['wipe','Wipe'],['glitch','Glitch'],['shutter','Shutter'],['stripes','Stripes'],['fade','Fade to black'],['scan','Scan line'],['none','None']],b.transition)}</select></div></div>
    <div class="srcbox">${srcLine(m)}</div>
    <div class="nwfind"><label>Picture search</label><input type="text" class="find" value="${esc(b.find||'')}" placeholder="what the picture should show, in English — e.g. Nvidia Jensen Huang"><button class="ghost fg" title="Search pictures for this beat (Bing / Wikipedia / Commons)">🔎 Find pictures</button></div>
    <div class="nwpick hide"></div>
    <div class="hold ${b.say?'hide':''}" style="margin-top:6px"><label>No narration: show for (s)</label><input type="number" class="nb-hold" min="0" max="60" step="0.5" value="${b.hold||0}" style="width:110px"></div>`;
   const q=s=>d.querySelector(s);
   const upd=()=>{b.find=q('.find').value;b.say=q('.say').value;b.title=q('.title').value;b.sub=q('.sub').value;b.tag=q('.nb-tag').value;b.in=+q('.in').value||0;b.out=+q('.out').value||0;b.sound=q('.snd').checked;b.move=q('.move').value;b.fit=q('.fit').value;b.transition=q('.tr').value;b.hold=+q('.nb-hold').value||0;q('.hold').classList.toggle('hide',!!b.say.trim());dirty()};
