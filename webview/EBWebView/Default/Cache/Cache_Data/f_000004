 function watchJob(){clearInterval(poll);if(!P)return;const id=P.id;
  const tick=async()=>{if(!P||P.id!==id){clearInterval(poll);return}let s;try{s=await api(`/news/p/${id}/status`)}catch(e){return}
   const lg=s.kind==='render'?el('nwRLog'):s.kind==='pics'?el('nwPLog'):el('nwWLog');if(s.log.length){lg.classList.remove('hide');lg.textContent=s.log.join('\n');lg.scrollTop=lg.scrollHeight}
   if(s.kind==='render'){el('nwRBar').style.width=s.progress+'%';el('nwGo').disabled=s.busy;el('nwStop').classList.toggle('hide',!s.busy)}
   if(s.busy){msg((s.kind==='render'?'Making the video… ':s.kind==='transcribe'?'Listening to the clip… ':s.kind==='pics'?'Finding pictures that match the beats… ':'Writing the script… ')+s.progress+'%');return}
   clearInterval(poll);
   if(s.failed){msg(s.failed,true);if(s.kind==='render')el('nwGo').disabled=false;if(s.kind==='transcribe')vidBox();if(s.kind==='pics')el('nwPics').disabled=false;return}
   if(s.done){clearTimeout(saveT);P=await api('/news/p/'+id);fill();await loadProjects();
    if(s.kind==='write'){go('script');msg(`✓ Script ready — ${P.script.beats.length} beats, ${new Set(P.script.beats.map(b=>b.media).filter(Boolean)).size} different pictures / clips. Check the words and pictures, then choose a style.`)}
    else if(s.kind==='pics'){el('nwPics').disabled=false;if(step==='script')drawBeats();msg(`✓ Pictures matched — ${new Set(P.script.beats.map(b=>b.media).filter(Boolean)).size} different pictures / clips for ${P.script.beats.length} beats`)}
    else if(s.kind==='transcribe'){go('story');msg('✓ The spoken words are added to the story — now write the script')}
    else{drawRender();msg('✓ Your news video is ready')}}};
  poll=setInterval(tick,1000);tick()}

