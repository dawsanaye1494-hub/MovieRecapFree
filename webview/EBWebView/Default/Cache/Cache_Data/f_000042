 /* ---------- lines ---------- */
 const ROLE_OPT=[['narrator','🎙 Narrator'],['female','👧 Girl / woman voice'],['male','👦 Boy / man voice']];
 function opt(sel,list,v){sel.replaceChildren();for(const [k,t] of list){const o=document.createElement('option');o.value=k;o.textContent=t;sel.append(o)}sel.value=v}
