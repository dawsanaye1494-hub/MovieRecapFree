   const how=r.headers.get('X-Voice')||'';a.src=URL.createObjectURL(await r.blob());a.play().catch(()=>{});msg('▶ Playing'+(how?' · '+how:''),how.startsWith('basic -'))}catch(e){msg(e.message,true)}}
 el('hrTestN').onclick=()=>testVoice({role:'narrator',mood:'normal'});el('hrTestF').onclick=()=>testVoice({role:'female',mood:'scared',who:'Girl',act:'terrified, alone in a dark house, voice shaking',text:P.lang!=='my'&&P.lang!=='en'&&window.OL&&OL.sample(P.lang)?OL.sample(P.lang):P.lang==='en'?'W-who is there? Please… please answer me.':'ဘ… ဘယ်သူလဲ… ဖြေပါဦး… အမေ…'});
