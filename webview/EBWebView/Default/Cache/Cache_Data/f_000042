 function moods(){el('hrMoods').querySelectorAll('.hrmood').forEach(c=>c.classList.toggle('on',c.dataset.v===P.music.mood))}
 function est(){if(!P)return;const cps=({my:9,en:13}[P.lang]||((window.OL&&OL.cps(P.lang))||10)*0.72)*(1+P.voice.rate/100);
  const lead={thunder:1.3,creak:1,knock:1.5,footsteps:1.8,heartbeat:1.9,whisper:.9,stinger:.7,bell:1.6,wind:1.6,slam:.8};
