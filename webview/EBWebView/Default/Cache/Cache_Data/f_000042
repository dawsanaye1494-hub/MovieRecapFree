 function fill(){if(!P)return;
  el('hrTitle').value=P.title||'';langSelects();el('hrLangSel').value=P.lang;el('hrSubLang').value=P.video.sub_lang||'';el('hrRaw').value=P.raw||'';rawN();el('hrIdea').value=P.idea||'';el('hrSetting').value=P.setting||'';
