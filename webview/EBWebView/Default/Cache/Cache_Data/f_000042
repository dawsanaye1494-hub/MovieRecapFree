 function go(s){step=s;el('hrSteps').querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.s===s));
  for(const x of ['story','lines','music','pics','make'])el('hr_'+x).classList.toggle('hide',x!==s);if(s==='lines')lines();if(s==='make')est()}
