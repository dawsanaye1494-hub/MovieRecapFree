 function body(){const {rev,title,lang,idea,setting,minutes,raw,lines,voice,music,video}=P;return {rev,title,lang,idea,setting,minutes,raw,lines,voice,music,video}}
 function later(){clearTimeout(saveT);saveT=setTimeout(flush,700)}
 async function flush(){clearTimeout(saveT);saveT=null;if(!P)return;if(saving)await saving;
  saving=api('/horror/p/'+P.id,body()).then(j=>{P.estimate=j.estimate;const o=el('hrProjects').querySelector(`option[value="${P.id}"]`);if(o)o.textContent=(j.done?'🎬 ':'')+(j.title||'Untitled story')+' · '+j.lines.length+' lines'}).catch(e=>msg(e.message,true)).finally(()=>{saving=null});await saving}

