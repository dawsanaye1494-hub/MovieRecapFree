  P.images.forEach((m,i)=>{const c=document.createElement('div');c.className='hrimg';
   c.innerHTML=`<img loading="lazy" src="/horror/p/${P.id}/img/${m.id}" alt=""><span class="k">${i+1}</span><div class="bar2"><button class="ghost" data-a="l" title="Earlier">←</button><button class="ghost" data-a="r" title="Later">→</button><span>${esc(m.name)}</span><button class="ghost" data-a="x" title="Remove">✕</button></div>`;
   c.querySelector('[data-a=l]').onclick=()=>move(i,-1);c.querySelector('[data-a=r]').onclick=()=>move(i,1);
   c.querySelector('[data-a=x]').onclick=async()=>{try{await flush();P=await api(`/horror/p/${P.id}/images/${m.id}`,undefined,'DELETE');pics();lines()}catch(e){msg(e.message,true)}};g.append(c)});est()}
 async function move(i,d){const j=i+d;if(j<0||j>=P.images.length)return;const a=P.images.slice();[a[i],a[j]]=[a[j],a[i]];P.images=a;pics();lines();
  await flush();try{P=await api('/horror/p/'+P.id,{order:a.map(m=>m.id)})}catch(e){msg(e.message,true)}}
 el('hrUp').onchange=async()=>{const fs=[...el('hrUp').files];el('hrUp').value='';if(!fs.length)return;el('hrUpMsg').textContent='Uploading '+fs.length+' pictures…';
  try{await flush();const j=await upload(`/horror/p/${P.id}/images`,fs);P=j.project;pics();lines();el('hrUpMsg').textContent=j.errors.length?j.errors.join(' · '):'✓ Added'}catch(e){el('hrUpMsg').textContent=e.message}};
