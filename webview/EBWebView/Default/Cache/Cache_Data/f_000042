  setSlider('hrMVol','hrMVolV',Math.round(P.music.vol*100),v=>v+'%');el('hrSfx').checked=P.music.sfx;el('hrAuto').checked=P.music.auto!==false;el('hrAuto').disabled=!P.music.sfx;
