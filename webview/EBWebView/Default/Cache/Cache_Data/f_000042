 el('hrKeySave').onclick=async()=>{const t=el('hrKeyAdd').value.trim();if(!t){msg('Paste a Gemini key first',true);return}
  try{const k=await api('/horror/keys',{add:t});el('hrKeyAdd').value='';keysShow(k);actUi();msg('Keys saved · '+k.count+' keys for acted voices')}catch(e){msg(e.message,true)}};
