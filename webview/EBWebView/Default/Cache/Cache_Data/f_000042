 /* ---------- extra Gemini keys (acted voices only) ---------- */
 function keysShow(k){META.voice_keys=k.count;el('hrKeyN').textContent='· '+k.count+' key'+(k.count===1?'':'s')+' in use';
  const box=el('hrKeyList');box.replaceChildren();
