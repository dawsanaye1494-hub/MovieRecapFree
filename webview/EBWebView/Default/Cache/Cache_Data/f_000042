 function actUi(){const v=P.voice,on=v.acting!=='basic';mark(el('hrActing'),on?'acted':'basic');el('hrActRow').classList.toggle('hide',!on);
  el('hrGirlV').value=v.girl||'auto';el('hrBoyV').value=v.boy||'auto';el('hrNarrAct').checked=!!v.narr_acted;
