 /* ---------- script jobs ---------- */
 async function script(m){if(!P)return;if(m==='mine'&&!el('hrRaw').value.trim()){msg('Paste your story script first',true);return}
  if(m==='mine'&&P.lines.length&&!await uiConfirm('Replace the current lines with this script?'))return;
  if(m==='gemini'&&P.lines.length&&!await uiConfirm('Gemini will write a NEW story and replace the current lines. Continue?'))return;
  P.raw=el('hrRaw').value;P.minutes=minSel;try{await flush();await api(`/horror/p/${P.id}/script`,{mode:m});el('hrWLog').classList.remove('hide');el('hrWLog').textContent='Starting…';watch()}catch(e){msg(e.message,true)}}
 el('hrRead').onclick=()=>script('mine');el('hrWrite').onclick=()=>script('gemini');

 function watch(){clearInterval(poll);const id=P.id;
  const tick=async()=>{if(!P||P.id!==id){clearInterval(poll);return}let s;try{s=await api(`/horror/p/${id}/status`)}catch(e){return}
   const logBox=s.kind==='render'?el('hrRLog'):el('hrWLog');logBox.classList.remove('hide');logBox.textContent=(s.log||[]).join('\n');logBox.scrollTop=1e9;
   if(s.kind==='render'){el('hrBar').style.width=(s.progress||0)+'%';el('hrGo').disabled=!!s.busy;el('hrStop').classList.toggle('hide',!s.busy)}
   if(s.busy){msg((s.kind==='render'?'Making the video… ':'Working on the script… ')+(s.progress||0)+'%');return}
   clearInterval(poll);
   if(s.failed){msg(s.failed,true);return}
   if(s.done){P=await api('/horror/p/'+id);await loadProjects();
    if(s.kind==='render'){doneUi(true);msg('✓ Video ready — press Save video')}else{fill();go('lines');msg(`✓ ${P.lines.length} lines · about ${fmtS(P.estimate)} — check the voices, then choose music and pictures`)}}};
  poll=setInterval(tick,1500);tick()}

